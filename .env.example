# AWS SES MCP Server Configuration
# Copy this file to .env and fill in your credentials

# Required: AWS credentials with SES permissions
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: AWS region for SES (default: us-east-1)
AWS_SES_REGION=us-east-1

# Required: Verified sender email address in SES
AWS_SES_FROM_EMAIL=your_verified_email@example.com
